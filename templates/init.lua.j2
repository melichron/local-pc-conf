vim.cmd("syntax enable")
vim.cmd("filetype plugin indent on")

vim.keymap.set("n", "Q", "gq", { desc = "Format with operator" })
vim.keymap.set("i", "<C-u>", "<C-g>u<C-u>", { desc = "Delete to line start with undo break" })
vim.keymap.set("n", "<C-l>", "<cmd>tabnext<cr>", { silent = true, desc = "Next tab" })
vim.keymap.set("n", "<C-h>", "<cmd>tabprevious<cr>", { silent = true, desc = "Previous tab" })

local cursor_group = vim.api.nvim_create_augroup("restore_cursor", { clear = true })
vim.api.nvim_create_autocmd("BufReadPost", {
  group = cursor_group,
  callback = function(event)
    local mark = vim.api.nvim_buf_get_mark(event.buf, '"')
    local line_count = vim.api.nvim_buf_line_count(event.buf)
    if mark[1] > 0 and mark[1] <= line_count and vim.bo[event.buf].filetype ~= "gitcommit" then
      pcall(vim.api.nvim_win_set_cursor, 0, mark)
    end
  end,
})

vim.api.nvim_create_user_command("DiffOrig", function()
  vim.cmd("vert new")
  vim.bo.buftype = "nofile"
  vim.cmd("read ++edit #")
  vim.cmd("0delete _")
  vim.cmd("diffthis")
  vim.cmd("wincmd p")
  vim.cmd("diffthis")
end, { desc = "Compare the current buffer with the file on disk" })

local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not vim.uv.fs_stat(lazypath) then
  local output = vim.fn.system({
    "git",
    "clone",
    "--filter=blob:none",
    "--branch=stable",
    "https://github.com/folke/lazy.nvim.git",
    lazypath,
  })
  if vim.v.shell_error ~= 0 then
    error("Failed to install lazy.nvim:\n" .. output)
  end
end
vim.opt.rtp:prepend(lazypath)

