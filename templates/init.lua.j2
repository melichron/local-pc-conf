vim.g.mapleader = " "
vim.g.maplocalleader = " "

-- nvim-tree replaces netrw, so disable netrw before loading plugins.
vim.g.loaded_netrw = 1
vim.g.loaded_netrwPlugin = 1

local opt = vim.opt

opt.backspace = { "indent", "eol", "start" }
opt.history = 200
opt.ruler = true
opt.showcmd = true
opt.wildmenu = true
opt.timeout = true
opt.timeoutlen = 500
opt.ttimeout = true
opt.ttimeoutlen = 100
opt.scrolloff = 5
opt.incsearch = true
opt.hlsearch = true
opt.ignorecase = true
opt.smartcase = true
opt.mouse = "a"
opt.termguicolors = true
opt.number = true
opt.signcolumn = "yes"
opt.splitbelow = true
opt.splitright = true
opt.undofile = true
opt.updatetime = 250
opt.completeopt = { "menu", "menuone", "noselect" }
